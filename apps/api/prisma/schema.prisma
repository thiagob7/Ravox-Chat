generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ChannelType {
  TEXT
  VOICE
  FORUM
  LINK
}

enum ContentVisibility {
  DEFAULT
  SPOILER
  AGE_RESTRICTED
}

enum VideoQuality {
  AUTO
  HD
}

enum MessageType {
  USER
  JOIN
  COMANDO
}

enum AutoModTrigger {
  WORDS
  MENTION_SPAM
  LINKS
}

enum AutoModAction {
  BLOCK
  ALERT
  TIMEOUT
}

enum PresenceStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

/// O que a pessoa ESCOLHEU, que não é o mesmo que os outros veem.
/// Quem escolhe INVISIBLE aparece OFFLINE para todo mundo, e quem escolhe
/// ONLINE aparece IDLE depois de um tempo parado. A projeção das duas coisas
/// é o `PresenceStatus` acima.
enum DesiredStatus {
  ONLINE
  IDLE
  DND
  INVISIBLE
}

enum OverwriteType {
  ROLE
  MEMBER
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum FiltroDeSpam {
  TODOS
  DESCONHECIDOS
  NENHUM
}

enum PedidoDeDmStatus {
  PENDING
  ACCEPTED
  IGNORED
  UNDELIVERED
}

type Attachment {
  id          String
  url         String
  filename    String
  contentType String
  size        Int
  width       Int?
  height      Int?
  spoiler     Boolean @default(false)
  description String?
  durationMs   Int? @map("duracaoMs")
  waves       String? @map("ondas")
}

type PollOption {
  id      String
  text   String @map("texto")
  emoji   String?
  userIds String[] @db.ObjectId
}

type EmbedField {
  name   String
  value  String
  inline Boolean @default(false)
}

type EmbedAuthor {
  name    String
  url     String?
  iconUrl String?
}

type EmbedFooter {
  text    String
  iconUrl String?
}

type Embed {
  title        String?
  description  String?
  url          String?
  color        Int?
  author       EmbedAuthor?
  fields       EmbedField[]
  thumbnailUrl String?
  imageUrl     String?
  footer       EmbedFooter?
  timestamp    DateTime?
}

type SelectOption {
  label       String
  value       String
  description String?
  emoji       String?
}

type Component {
  type        String
  style       String?
  label       String?
  emoji       String?
  customId    String?
  url         String?
  disabled    Boolean        @default(false)
  placeholder String?
  minValues   Int?
  maxValues   Int?
  options     SelectOption[]
}

type ComponentRow {
  components Component[]
}

type Poll {
  question    String @map("pergunta")
  options      PollOption[]
  multiSelect Boolean     @default(false)
  expiresAt   DateTime?
  closedAt    DateTime?
}

model User {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  email       String         @unique
  username    String         @unique
  displayName String
  avatarUrl   String?
  bio         String?
  pronouns    String? @map("pronomes")
  isBot       Boolean        @default(false)
  system     Boolean? @map("sistema")
  passwordHash   String? @map("senhaHash")
  emailVerifiedAt DateTime? @map("emailVerificadoEm")
  status      PresenceStatus @default(OFFLINE)
  /// Escolha durável, não cache: tem que sobreviver a um Redis reiniciado.
  desiredStatus DesiredStatus @default(ONLINE) @map("statusEscolhido")
  profile              ProfileStyle?
  customStatus CustomStatus?
  lastSeenAt  DateTime?

  acceptedRequests   Boolean @default(true) @map("aceitaPedidos")
  showsActivity Boolean @default(true) @map("mostraAtividade")

  membersAllowDm Boolean      @default(true) @map("permitirDmDeMembros")
  spamFilter        FiltroDeSpam @default(DESCONHECIDOS) @map("filtroDeSpam")

  showsServersCommon Boolean @default(true) @map("mostraServidoresEmComum")
  showsFriendsCommon     Boolean @default(true) @map("mostraAmigosEmComum")

  deleteAt DateTime? @map("excluirEm")

  premiumUntil  DateTime?
  premiumSource String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  accounts            Account[]
  refreshTokens       RefreshToken[]
  memberships         GuildMember[]
  ownedGuilds         Guild[]        @relation("GuildOwner")
  messages            Message[]
  reactions           Reaction[]
  readStates          ReadState[]
  invitesCreated      Invite[]
  streamKeys          StreamKey[]
  friendshipsSent     Friendship[]   @relation("FriendshipRequester")
  friendshipsReceived Friendship[]   @relation("FriendshipAddressee")
  pedidosDeDmEnviados  DmRequest[]  @relation("PedidoDeDmDe")
  pedidosDeDmRecebidos DmRequest[]  @relation("PedidoDeDmPara")
  webhookIdentity     Webhook?       @relation("WebhookBot")
  webhooksCreated     Webhook[]      @relation("WebhookCreator")
  auditLogs           AuditLog[]     @relation("AuditActor")
  notasEscritas       UserNote[]     @relation("NotasEscritas")
  notasRecebidas      UserNote[]     @relation("NotasRecebidas")
  bans                Ban[]          @relation("BanTarget")
  forumPosts          ForumPost[]    @relation("PostAuthor")
  gifsFavoritos       GifFavorite[]
  mensagensFavoritas  MessageFavorite[]
  botsCriados         Bot[]          @relation("BotOwner")
  temasPublicados     Theme[]         @relation("TemaAutor")
  botIdentity         Bot?           @relation("BotIdentity")
}

model Webhook {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId   String   @db.ObjectId
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId String   @db.ObjectId
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name      String
  avatarUrl String?
  token     String   @unique
  botUserId String   @unique @db.ObjectId
  bot       User     @relation("WebhookBot", fields: [botUserId], references: [id], onDelete: Cascade)
  createdById String @db.ObjectId
  createdBy User     @relation("WebhookCreator", fields: [createdById], references: [id])
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([channelId])
}

model Account {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  supersededAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Guild {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  iconUrl     String?
  bannerUrl   String?
  description String?
  tag       String?
  tagIcon   String?
  systemChannelId String? @db.ObjectId
  welcomeEnabled  Boolean @default(true)
  welcomeMessage  String?
  category   String? @map("categoria")
  discoverable Boolean? @default(true) @map("descobrivel")
  verified  Boolean? @map("verificada")
  community            Boolean? @default(false) @map("comunidade")
  communitySince       DateTime? @map("comunidadeDesde")
  rulesChannelId       String?  @db.ObjectId @map("canalDeRegrasId")
  noticesChannelId       String?  @db.ObjectId @map("canalDeAvisosId")
  securityChannelId    String?  @db.ObjectId @map("canalDeSegurancaId")
  languagePrincipal       String? @map("idiomaPrincipal")
  verifiedRequiresEmail  Boolean? @default(false) @map("exigeEmailVerificado")
  filtersMediaExplicit  Boolean? @default(false) @map("filtraMidiaExplicita")
  tags                 String[] @default([]) @map("etiquetas")
  afkChannelId         String?  @db.ObjectId @map("canalDeInatividadeId")
  afkTimeoutSeconds    Int?     @default(300) @map("tempoDeInatividade")
  defaultNotifications String?  @default("tudo") @map("notificacaoPadrao")
  flexibleChannelNames Boolean? @default(false) @map("nomesDeCanalLivres")
  hideOwnerCrown       Boolean? @default(false) @map("ocultarCoroaDoDono")
  ownerId   String   @db.ObjectId
  owner     User     @relation("GuildOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    GuildMember[]
  categories Category[]
  channels   Channel[]
  invites    Invite[]
  events     GuildEvent[]
  roles      Role[]
  webhooks   Webhook[]
  bans       Ban[]
  auditLogs  AuditLog[]
  emojis     GuildEmoji[]
  stickers   GuildSticker[]
  sounds     GuildSound[]
  emblems    GuildEmblem[]
  automod    AutoModRule[]

  @@index([ownerId])
}

type NameStyle {
  font  String? @map("fonte")
  effect String? @map("efeito")
  color    String? @map("cor")
  color2   String? @map("cor2")
}

type ProfileStyle {
  name           NameStyle?
  tag       String? @map("etiqueta")
  tagGuildId     String?  @db.ObjectId
  rank        String? @map("patente")
  decoration      String? @map("decoracao")
  frame        String? @map("moldura")
  effect         String? @map("efeito")
  plate          String? @map("placa")
  bannerUrl      String?
  bannerColor      String? @map("bannerCor")
  themePrimary   String? @map("temaPrimario")
  secondaryTheme String? @map("temaSecundario")
  connections       Connection[]
}

type Connection {
  service String @map("servico")
  value   String @map("valor")
}

type CustomStatus {
  text    String @map("texto")
  emoji    String?
  expiresAt DateTime? @map("expiraEm")
}

model GuildMember {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId  String   @db.ObjectId
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId   String   @db.ObjectId
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleIds  String[] @db.ObjectId
  emblemIds String[] @db.ObjectId
  nickname String?
  avatarUrl String?
  bannerUrl String?
  bio String?
  timeoutUntil DateTime?
  inviteCode String?
  invitedById String? @db.ObjectId
  joinedAt DateTime @default(now())

  @@unique([guildId, userId])
  @@index([userId])
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String   @db.ObjectId
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  position    Int      @default(0)
  permissions String[]
  hoist       Boolean  @default(false)
  colorSecondary String?
  iconUrl        String?
  iconEmoji      String?
  style         String? @map("estilo")
  mentionable Boolean  @default(false)
  isEveryone  Boolean  @default(false)
  createdAt   DateTime @default(now())

  overwrites PermissionOverwrite[]

  @@index([guildId, position])
}

model PermissionOverwrite {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  channelId String        @db.ObjectId
  channel   Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  targetId  String        @db.ObjectId
  role      Role?         @relation(fields: [targetId], references: [id], onDelete: Cascade)
  type      OverwriteType
  allow     String[]
  deny      String[]

  @@unique([channelId, targetId])
  @@index([channelId])
}

model Category {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  guildId  String  @db.ObjectId
  guild    Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name     String
  position Int     @default(0)

  channels Channel[]

  @@index([guildId, position])
}

model Channel {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  guildId    String?     @db.ObjectId
  guild      Guild?      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  categoryId String?     @db.ObjectId
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name       String
  font      String? @map("fonte")
  type       ChannelType @default(TEXT)
  topic      String?
  url        String?
  position   Int         @default(0)
  isPrivate  Boolean     @default(false)
  slowmodeSeconds Int    @default(0)
  contentVisibility ContentVisibility @default(DEFAULT)
  status     String?
  bitrate    Int         @default(64000)
  videoQuality VideoQuality @default(AUTO)
  userLimit  Int         @default(0)
  recipients String[]    @db.ObjectId
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  messages   Message[]
  readStates ReadState[]
  invites    Invite[]
  streamKeys StreamKey[]
  dmRequest DmRequest?
  overwrites PermissionOverwrite[]
  webhooks   Webhook[]
  posts      ForumPost[]

  @@index([guildId, position])
  @@index([categoryId])
}

model Message {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  channelId   String       @db.ObjectId
  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String       @db.ObjectId
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// O `nonce` do envio, para reconhecer o reenvio da fila depois que o recibo do Redis venceu.
  nonce       String?
  content     String
  font       String? @map("fonte")
  kind        MessageType  @default(USER) @map("tipo")
  attachments Attachment[]
  poll        Poll?
  embeds      Embed[]
  components  ComponentRow[]
  stickerId   String?       @db.ObjectId
  sticker     GuildSticker? @relation(fields: [stickerId], references: [id], onDelete: SetNull)
  replyToId   String?      @db.ObjectId
  channelForwardedId    String?  @db.ObjectId @map("encaminhadaDeCanalId")
  messageForwardedId String?  @db.ObjectId @map("encaminhadaDeMensagemId")
  mentions    String[]     @db.ObjectId
  mentionRoleIds String[]  @db.ObjectId
  mentionEveryone Boolean?
  postId      String?      @db.ObjectId
  post        ForumPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  pinnedAt    DateTime?
  pinnedById  String?      @db.ObjectId
  createdAt   DateTime     @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?

  reactions Reaction[]
  favoritada MessageFavorite[]

  @@index([channelId, createdAt])
  @@index([postId, createdAt])
  @@index([channelId, pinnedAt])
  @@index([authorId])
}

model Reaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId String   @db.ObjectId
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  burst     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model ReadState {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId         String   @db.ObjectId
  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadMessageId String?  @db.ObjectId
  mentionCount      Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@unique([userId, channelId])
  @@index([userId])
}

model Invite {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  code      String    @unique
  guildId   String    @db.ObjectId
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId String?   @db.ObjectId
  channel   Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  inviterId String    @db.ObjectId
  inviter   User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  uses      Int       @default(0)
  maxUses   Int?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([guildId])
}

model StreamKey {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String   @db.ObjectId
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  @@unique([userId, channelId])
}

model Friendship {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  requesterId String           @db.ObjectId
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String           @db.ObjectId
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  note      String? @map("recado")
  createdAt   DateTime         @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model DmRequest {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  channelId String           @unique @db.ObjectId
  channel   Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  fromId    String           @db.ObjectId
  from      User             @relation("PedidoDeDmDe", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String           @db.ObjectId
  to        User             @relation("PedidoDeDmPara", fields: [toId], references: [id], onDelete: Cascade)
  status    PedidoDeDmStatus @default(PENDING)
  spam      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([toId, status])
  @@map("PedidoDeDm")
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId    String   @db.ObjectId
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actorId    String   @db.ObjectId
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String?
  targetName String?
  changes    Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([guildId, createdAt])
}

model Ban {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String   @db.ObjectId
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String   @db.ObjectId
  user        User     @relation("BanTarget", fields: [userId], references: [id], onDelete: Cascade)
  moderatorId String   @db.ObjectId
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([guildId, userId])
  @@index([guildId])
}

model AutoModRule {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  guildId        String          @db.ObjectId
  guild          Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name           String
  enabled        Boolean         @default(true)
  trigger        AutoModTrigger
  words       String[] @map("palavras")
  limitMentions  Int? @map("limiteMencoes")
  actions          AutoModAction[] @map("acoes")
  alertChannelId String?         @db.ObjectId
  timeoutSeconds Int?
  rolesExempt  String[]        @db.ObjectId @map("cargosIsentos")
  createdAt      DateTime        @default(now())

  @@index([guildId])
}

model GuildEmoji {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String   @db.ObjectId
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  url         String
  animated    Boolean  @default(false)
  createdById String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([guildId, name])
  @@index([guildId])
}

model GuildSticker {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId       String   @db.ObjectId
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  relatedEmoji  String
  url           String
  createdById   String   @db.ObjectId
  createdAt     DateTime @default(now())

  messages Message[]

  @@index([guildId])
}

model GuildSound {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String   @db.ObjectId
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  emoji       String?
  url         String
  volume      Float    @default(1)
  createdById String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@index([guildId])
}

model ForumPost {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  channelId     String    @db.ObjectId
  channel       Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  guildId       String    @db.ObjectId
  authorId      String    @db.ObjectId
  author        User      @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title         String
  tags          String[]
  lastMessageAt DateTime  @default(now())
  messageCount  Int       @default(0)
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  messages Message[]

  @@index([channelId, lastMessageAt])
}

model UserNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId   String   @db.ObjectId
  owner     User     @relation("NotasEscritas", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String   @db.ObjectId
  target    User     @relation("NotasRecebidas", fields: [targetId], references: [id], onDelete: Cascade)
  text     String @map("texto")
  updatedAt DateTime @updatedAt

  @@unique([ownerId, targetId])
}

model GuildEmblem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String   @db.ObjectId
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String @map("nome")
  emoji       String?
  iconUrl     String?
  createdById String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@index([guildId])
}

model GifFavorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gifId     String
  description String @map("descricao")
  url       String
  preview   String
  width     Int
  height    Int
  createdAt DateTime @default(now())

  @@unique([userId, gifId])
  @@index([userId, createdAt])
  @@map("GifFavorito")
}

model MessageFavorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String   @db.ObjectId
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, messageId])
  @@index([userId, createdAt])
  @@map("MensagemFavorita")
}

model Bot {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId   String   @db.ObjectId
  owner     User     @relation("BotOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  botUserId String   @unique @db.ObjectId
  user   User     @relation("BotIdentity", fields: [botUserId], references: [id], onDelete: Cascade)
  token     String   @unique
  description String? @map("descricao")
  coverUrl   String? @map("capaUrl")
  categories String[] @default([]) @map("categorias")
  languages   String[] @default([]) @map("idiomas")
  termsUrl String? @map("urlDosTermos")
  policyUrl String? @map("urlDaPolitica")
  supportServerId String? @db.ObjectId @map("servidorDeSuporteId")
  permissionsRequested String[] @map("permissoesPedidas")
  isPublic   Boolean  @default(true) @map("publico")
  clientSecret String @default("")
  redirectUris String[]
  commands  Json? @map("comandos")
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model DayStatus {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  piece    String @map("peca")
  day     String @map("dia")
  measures Int    @default(0) @map("medidas")
  failures  Int    @default(0) @map("falhas")
  msSoma  Int    @default(0)

  updatedAt DateTime @updatedAt @map("atualizadoEm")

  @@unique([piece, day])
  @@index([day])
  @@map("StatusDoDia")
}

model Theme {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String @map("nome")
  description String? @map("descricao")
  author     String? @map("autor")
  version    String? @map("versao")
  tags      String[] @default([])
  css       String
  overrides Json @map("substituicoes")
  actives    Json? @map("ativos")
  bytes     Int      @default(0)
  authorId   String   @db.ObjectId @map("autorId")
  user   User     @relation("TemaAutor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([authorId])
  @@map("Tema")
}

model GuildEvent {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  guildId          String    @db.ObjectId
  guild            Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  authorId         String    @db.ObjectId
  name             String
  description      String?
  imageUrl         String?
  startsAt         DateTime
  frequency        String    @default("once")
  channelId        String?   @db.ObjectId
  externalLocation String?
  interestedIds    String[]  @db.ObjectId
  startedAt        DateTime?
  canceledAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([guildId, startsAt])
}

model Report {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  kind      String? @map("tipo")
  guildId   String?  @db.ObjectId
  messageId String?  @db.ObjectId
  channelId String?  @db.ObjectId
  accusedId String?  @db.ObjectId @map("acusadoId")
  snippet    String? @map("trecho")
  authorId   String   @db.ObjectId @map("autorId")
  reason    String @map("motivo")
  details  String? @map("detalhes")
  resolvedAt  DateTime? @map("resolvidaEm")
  resolvedBy String?  @db.ObjectId @map("resolvidaPor")
  decision      String? @map("decisao")
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([messageId])
  @@index([resolvedAt])
  @@map("Denuncia")
}

/// Quem entra no painel de administração sem ser dono. O dono vem de
/// ADMIN_EMAILS e não mora aqui. Sem índice único de propósito: o deploy não
/// roda `db push`, então a unicidade por pessoa é garantida no código.
model AdminMember {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @db.ObjectId
  email            String
  areas            String[]
  passwordHash     String    @map("senhaHash")
  mustChangePassword Boolean @default(true) @map("trocarSenha")
  passwordSetAt    DateTime  @default(now()) @map("senhaDefinidaEm")
  lastUnlockAt     DateTime? @map("ultimaEntradaEm")
  addedById        String?   @db.ObjectId
  createdAt        DateTime  @default(now())

  @@map("Administrador")
}

/// O que foi feito no painel, e por quem.
model AdminLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId   String   @db.ObjectId
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@map("RegistroDeAdministracao")
}

/// Cliente da Stripe de cada conta e o estado da assinatura no cartão.
/// Os índices únicos exigem `db push` antes de ligar a cobrança.
model BillingCustomer {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String    @unique @db.ObjectId
  stripeCustomerId   String    @unique
  subscriptionId     String?
  subscriptionStatus String?
  interval           String?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Cada pagamento que liberou premium: fatura da assinatura ou período avulso.
model BillingPayment {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  kind            String
  sourceId        String    @unique
  paymentIntentId String?
  amount          Int
  currency        String
  days            Int?
  paidAt          DateTime
  refundedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, paidAt])
  @@index([paymentIntentId])
}

/// Eventos da Stripe já tratados, para o mesmo evento não liberar premium duas vezes.
model BillingEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  stripeId    String   @unique
  type        String
  processedAt DateTime @default(now())
}

/// Presente do Infinity: quem paga ganha um código, e quem resgata recebe os dias.
model Gift {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  code        String    @unique
  interval    String
  days        Int
  amount      Int
  buyerId     String    @db.ObjectId
  sourceId    String    @unique
  claimedById String?   @db.ObjectId
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([buyerId, createdAt])
}

/// Pix avulso cobrado pelo Mercado Pago: o QR vale até expiresAt e libera os dias quando é pago.
model PixCharge {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  interval     String
  target       String    @default("me")
  days         Int
  amount       Int
  mpPaymentId  String?
  mpOrderId    String?
  qrCode       String?
  qrCodeBase64 String?
  status       String    @default("pending")
  expiresAt    DateTime
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([mpPaymentId])
  @@index([mpOrderId])
}

/// Quadro vendido na coluna "Ativo agora". Só quem está no plano grátis vê.
/// Sem índice de propósito: a coleção é pequena e o deploy não roda `db push`.
model Ad {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  advertiser  String
  title       String
  body        String?
  imageUrl    String?
  linkUrl     String
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  impressions Int       @default(0)
  clicks      Int       @default(0)
  createdById String?   @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
